# Copy to .env and fill in. .env is gitignored — never commit a real private key.
# lib/env.ts loads this file automatically; no dotenv dependency needed.

# ---------------------------------------------------------------------------
# Required for every live-chain command (seed / verify / index / query)
# ---------------------------------------------------------------------------

# Any Sepolia JSON-RPC endpoint. The public default works for reads only.
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# The ENS name that owns the seeded subnames. You must control this name with
# the PRIVATE_KEY below, otherwise seeding fails with "deployer does not own".
# Get one for free at https://app.ens.domains/testnet (testnet mode).
#
# NOTE: the roster below it has not been written yet, so `npm run verify`
# reports 0/9. The parent itself IS registered — see README section 4 for the
# ENSv2 caveat, which is why an older verifier wrongly called it unregistered.
COMMUNITY_PARENT_NAME=kenji-community-pk2026.eth

# ---------------------------------------------------------------------------
# Required only for `npm run seed`
# ---------------------------------------------------------------------------

# Deployer key. Needs test ETH on Sepolia (faucet: https://sepoliafaucet.com)
# and must be the owner — or the NameWrapper NFT holder — of COMMUNITY_PARENT_NAME.
# Never use a key that holds mainnet funds.
PRIVATE_KEY=

# Set to 1 to print the plan without sending any transaction.
SEED_DRY_RUN=1

# ---------------------------------------------------------------------------
# Retrieval (all optional — the index is lexical-only by default)
# ---------------------------------------------------------------------------

# none | gemini | ollama | hashing. Leave unset or use "none" for zero dependencies.
EMBEDDING_PROVIDER=none

# --- gemini ---------------------------------------------------------------
# Only needed when EMBEDDING_PROVIDER=gemini. Free tier key from
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=text-embedding-004

# --- ollama ---------------------------------------------------------------
# Only needed when EMBEDDING_PROVIDER=ollama. Runs fully locally, no key.
# `ollama pull nomic-embed-text` first.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# ---------------------------------------------------------------------------
# Grounded answers (all optional — lib/llm-config.ts)
# ---------------------------------------------------------------------------
# Only needed by answerQuestion(). Defaults target a local Ollama, so leaving
# this whole section unset still works if `ollama serve` is running.

# Any OpenAI-compatible /chat/completions endpoint. Note the /v1 suffix.
LLM_BASE_URL=http://localhost:11434/v1

# Leave empty to send no Authorization header at all (Ollama ignores it anyway).
# For a real provider set it here; never commit a real key — .env is gitignored.
LLM_API_KEY=ollama

# Any model that supports JSON mode. `ollama pull llama3.2` first.
LLM_MODEL=llama3.2

# Hard ceiling on one request. The client aborts rather than hanging, and does
# not retry a timeout. A bad value raises at startup instead of becoming NaN.
LLM_TIMEOUT_MS=30000

# Retries apply to 429 and 5xx only, with exponential backoff. 0 disables them.
LLM_MAX_RETRIES=3
LLM_RETRY_BASE_DELAY_MS=500

# Ceiling for a single wait. A hostile Retry-After: 86400 is honoured as a
# request but clamped to this, so a rate limit cannot park the caller for a day.
LLM_MAX_RETRY_DELAY_MS=8000

# ---------------------------------------------------------------------------
# Web UI (server/index.ts)
# ---------------------------------------------------------------------------

# Port for `npm start`. Change it if 3000 is taken: PORT=4000 npm start
PORT=3000

# Set to 1 to run the UI against the in-memory fixture profiles instead of
# reading Sepolia. Lets you demo the whole pipeline with no RPC endpoint.
USE_FIXTURES=

# A no-key endpoint that works for a first run, if you have no provider handy:
#   LLM_BASE_URL=https://text.pollinations.ai/openai
#   LLM_MODEL=openai-fast
#   LLM_API_KEY=
# It throttles anonymous callers with a transient HTTP 402, so use your own
# endpoint for anything load-bearing.
